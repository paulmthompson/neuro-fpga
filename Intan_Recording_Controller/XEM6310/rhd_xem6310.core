CAPI=2:
name: paulmthompson:neuro-fpga:rhd_xem6310:0.1.0
description: RHD2000 recording controller for Opal Kelly XEM6310 (Xilinx Spartan-6 xc6slx45)

filesets:
  ise_ngc:
    files:
      - ise_add_ngc.tcl: {file_type: tclSource}

  ngc_netlists:
    file_type: user
    files:
      - fifo_w16_4096_r32_2048.ngc
      - fifo_w32_2048_r32_2048.ngc
      - multiplier_18x18.ngc
      - multiplier.ngc
      - okBTPipeIn.ngc
      - okBTPipeOut.ngc
      - okCoreHarness.ngc
      - okCoreHarnessNoAuth.ngc
      - okPipeIn.ngc
      - okPipeOut.ngc
      - okRegisterBridge.ngc
      - okTriggerIn.ngc
      - okTriggerOut.ngc
      - okWireIn.ngc
      - okWireOut.ngc
      - TFIFO64x8a_64x8b.ngc

  rtl:
    depend:
      - paulmthompson:neuro-fpga:rhythm_shared:0.1.0
    file_type: verilogSource
    files:
      - iodrp_mcb_controller.v
      - iodrp_controller.v
      - mcb_soft_calibration.v
      - mcb_soft_calibration_top.v
      - mcb_raw_wrapper.v
      - RAM_block.v
      - multiplier_18x18.v
      - memc3_wrapper.v
      - memc3_infrastructure.v
      - fifo_w32_2048_r32_2048.v
      - fifo_w16_4096_r32_2048.v
      - ddr2_state_machine.v
      - variable_freq_clk_generator.v
      - SDRAM_FIFO.v
      - RAM_bank.v
      - okLibrary.v
      - MISO_phase_selector.v
      - digital_input_deserializer.v
      - DAC_output_scalable_HPF.v
      - command_selector.v
      - ADC_input.v
      - main.v

  constraints:
    files:
      - xem6310.ucf: {file_type: UCF}

targets:
  default: &default
    filesets:
      - ise_ngc
      - ngc_netlists
      - rtl
      - constraints
    toplevel: main

  bitstream:
    <<: *default
    description: Synthesize and generate main.bit with Xilinx ISE 14.7
    default_tool: ise
    tools:
      ise:
        family: spartan6
        device: xc6slx45
        package: fgg484
        speed: "-2"
